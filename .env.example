# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real credentials.

# --- Database ---
DB_ROOT_PASSWORD=change_me_root_password
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change_me_password

# --- WordPress ---
WP_TABLE_PREFIX=wp_
WORDPRESS_PORT=8080

# --- phpMyAdmin ---
PHPMYADMIN_PORT=8081

# --- ACF PRO ---
# Licence key from advancedcustomfields.com -> My Account -> Licenses.
# Leave empty to stay on the free edition (the site runs fine without it).
# Once set, `just acf-pro` swaps the free plugin for PRO and activates the key.
ACF_PRO_LICENSE=
