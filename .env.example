# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real credentials.

# --- Database ---
DB_ROOT_PASSWORD=change_me_root_password
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change_me_password

# --- WordPress ---
WP_TABLE_PREFIX=wp_
WORDPRESS_PORT=8080

# --- phpMyAdmin ---
PHPMYADMIN_PORT=8081
