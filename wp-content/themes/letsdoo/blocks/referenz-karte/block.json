{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"name": "letsdoo/referenz-karte",
	"title": "Referenz-Karte",
	"description": "Eine ausgewählte Referenz als Karte mit Logo, Kurztext und Link.",
	"category": "letsdoo",
	"icon": "star-filled",
	"keywords": [ "referenz", "kunde", "case study" ],
	"textdomain": "letsdoo",
	"supports": {
		"anchor": true,
		"align": [ "full" ],
