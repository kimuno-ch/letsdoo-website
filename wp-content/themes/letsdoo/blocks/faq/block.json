{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"name": "letsdoo/faq",
	"title": "FAQ",
	"description": "Häufige Fragen. Erzeugt zusätzlich das FAQPage-Schema für Google.",
	"category": "letsdoo",
	"icon": "editor-help",
	"keywords": [ "faq", "fragen", "antworten", "schema" ],
	"textdomain": "letsdoo",
	"supports": {
		"anchor": true,
		"align": [ "full" ],
		"html": false,
		"customClassName": false,
		"reusable": false
	},
	"attributes": {
		"align": { "type": "string", "default": "full" }
	},
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	}
}
