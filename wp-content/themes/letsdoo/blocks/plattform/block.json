{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"name": "letsdoo/plattform",
	"title": "Plattform (App-Raster)",
	"description": "Kategorisiertes Raster der Odoo-Apps, mit Icon und Kurzliste pro Kategorie.",
	"category": "letsdoo",
	"icon": "layout",
	"keywords": [ "odoo", "apps", "module", "plattform" ],
	"textdomain": "letsdoo",
	"supports": {
		"anchor": true,
		"align": [ "full" ],
		"html": false,
		"customClassName": false,
		"reusable": false
	},
	"attributes": {
		"align": { "type": "string", "default": "full" }
	},
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	}
}
